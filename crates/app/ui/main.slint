import { ScrollView, ComboBox } from "std-widgets.slint";

global Palette {
    out property <color> deep: #03141e;
    out property <color> deep-2: #0c3b51;
    out property <color> accent: #0e7490;
    out property <color> accent-hover: #128aa5;
    out property <color> accent-soft: #cffafe;
    out property <color> cyan: #67e8f9;
    out property <color> success: #16a34a;
    out property <color> success-hover: #15803d;
    out property <color> bg: #f0f9fb;
    out property <color> card: #ffffff;
    out property <color> line: #d2e7ec;
    out property <color> hover: #e6f6f9;
    out property <color> ink: #062a38;
    out property <color> muted: #5b7c87;
    out property <color> disabled: #a9c1c8;
    out property <color> on-accent: #ecfeff;
    out property <color> danger: #d8455f;
    // The live level inside a volume track. They are deliberately lighter and
    // warmer than the sea-teal fill they sit on, so the setting and the signal
    // read as two different things.
    out property <color> meter-low: #22c55e;
    out property <color> meter-mid: #f59e0b;
    out property <color> meter-high: #ef4444;
}

export global Labels {
    in property <string> idle_state: "";
    in property <string> recording_state: "";
    in property <string> saving_state: "";
    in property <string> capture: "";
    in property <string> settings: "";
    in property <string> refresh: "";
    in property <string> about: "";
    in property <string> hero_note: "";
    in property <string> screenshot: "";
    in property <string> record_screen: "";
    in property <string> format: "";
    in property <string> saved_next: "";
    in property <string> picture: "";
    in property <string> preset: "";
    in property <string> resolution: "";
    in property <string> frame_rate: "";
    in property <string> audio: "";
    in property <string> audio_capture: "";
    in property <string> camera: "";
    in property <string> camera_photo: "";
    in property <string> camera_video: "";
    in property <string> camera_choose: "";
    in property <string> system_audio: "";
    in property <string> microphone: "";
    in property <string> show_cursor: "";
    in property <string> quick_actions: "";
    in property <string> area_capture: "";
    in property <string> choose_source: "";
    in property <string> capture_audio: "";
    in property <string> screenshot_screen: "";
    in property <string> screenshot_area: "";
    in property <string> select_area: "";
    in property <string> recent: "";
    in property <string> no_captures: "";
    in property <string> folder: "";
    in property <string> open: "";
    in property <string> preferences: "";
    in property <string> hotkeys: "";
    in property <string> stop_recording: "";
    in property <string> not_set: "";
    in property <string> press_keys: "";
    in property <string> start_with_windows: "";
    in property <string> start_minimized: "";
    in property <string> hide_active: "";
    in property <string> close_tray: "";
    in property <string> clipboard: "";
    in property <string> tray_capture: "";
    in property <string> tray_capture_hint: "";
    in property <string> highlight: "";
    in property <string> completion_sound: "";
    in property <string> sounds: "";
    in property <string> volume: "";
    in property <string> play_on_save: "";
    in property <string> play_on_shot: "";
    in property <string> no_signal: "";
    in property <string> show_card: "";
    in property <string> show_level_idle: "";
    in property <string> tray_area: "";
    in property <string> tray_video: "";
    in property <string> monitor: "";
    in property <string> tray_audio: "";
    in property <string> performance_overlay: "";
    in property <string> overlay_renderer: "";
    in property <string> encoder_threads: "";
    in property <string> language: "";
    in property <string> quality: "";
    in property <string> balance: "";
    in property <string> speed: "";
    in property <string> custom: "";
    in property <string> auto: "";
    in property <string> copy: "";
    in property <string> copied: "";
    in property <string> screenshot_source: "";
    in property <string> screenshots: "";
    in property <string> video_recording: "";
    in property <string> video_animations: "";
    in property <string> file_locations: "";
    in property <string> default_folder: "";
    in property <string> change: "";
    in property <string> reset: "";
    in property <string> set_hotkey: "";
    in property <string> set_in_system_dialog: "";
    in property <string> close: "";
    in property <string> about_version: "";
    in property <string> about_note: "";
    in property <string> open_logs: "";
    in property <string> licenses: "";
    in property <string> license_text: "";
    in property <string> site: "";
    in property <string> github: "";
}

component SectionTitle inherits Text {
    height: 18px;
    font-size: 12px;
    font-weight: 700;
    color: Palette.muted;
    letter-spacing: 0.8px;
    vertical-alignment: center;
}

/// One row of the Settings hotkey table, built from the platform's action
/// table. `action` is the row's position in that table.
export struct HotkeyRow {
    action: int,
    label: string,
    value: string,
}

component OceanButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> success: false;
    in property <bool> enabled: true;
    callback clicked;

    height: 34px;
    border-radius: 10px;
    background: !root.enabled ? Palette.disabled : (ta.has-hover ? (root.success ? Palette.success-hover : (root.primary ? Palette.accent-hover : Palette.hover)) : (root.success ? Palette.success : (root.primary ? Palette.accent : Palette.card)));
    border-width: root.primary || root.success ? 0px : 1px;
    border-color: Palette.line;

    Text {
        text: root.label;
        color: (root.primary || root.success) ? Palette.on-accent : (root.enabled ? Palette.ink : #ffffff);
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked;

    height: 32px;
    border-radius: 9px;
    background: root.active ? Palette.accent : (ta.has-hover ? Palette.hover : Palette.card);
    border-width: 1px;
    border-color: root.active ? Palette.accent : Palette.line;

    Text {
        text: root.label;
        color: root.active ? Palette.on-accent : Palette.ink;
        font-size: 12px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Toggle inherits Rectangle {
    in property <string> label;
    in property <string> note: "";
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled;

    height: root.note == "" ? 36px : 44px;
    background: transparent;

    HorizontalLayout {
        spacing: 12px;
        Text {
            text: root.label;
            color: root.enabled ? Palette.ink : Palette.disabled;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.note;
            color: Palette.muted;
            font-size: 12px;
            vertical-alignment: center;
            visible: root.note != "";
        }
        Rectangle {
            width: 24px;
            height: 24px;
            border-radius: 8px;
            background: root.checked ? Palette.accent : (ta.has-hover ? Palette.hover : Palette.card);
            border-width: 1.5px;
            border-color: root.checked ? Palette.accent : Palette.line;
            Path {
                visible: root.checked;
                x: 5px;
                y: 4px;
                width: 14px;
                height: 16px;
                commands: "M 1 7 L 5 11 L 13 2";
                stroke: Palette.on-accent;
                stroke-width: 2.2px;
                fill: transparent;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(); }
    }
}

component OceanSlider inherits Rectangle {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> value: 50;
    in property <bool> enabled: true;
    // Live level of the source this slider sets, 0..1 from -60 dBFS to 0 dBFS.
    // Zero is silence, which leaves the track exactly as the setting draws it.
    in property <float> level: 0;
    callback changed(int);
    callback released;

    height: 30px;
    background: transparent;
    property <bool> dragging: false;

    function value-at(x: length) -> int {
        if (root.maximum <= root.minimum) { return root.minimum; }
        return Math.round(root.minimum + Math.max(0, Math.min(1, (x - 9px) / Math.max(1px, root.width - 18px))) * (root.maximum - root.minimum));
    }

    Rectangle {
        x: 0px;
        y: (root.height - 6px) / 2;
        width: root.width;
        height: 6px;
        border-radius: 3px;
        background: Palette.line;
    }
    Rectangle {
        x: 0px;
        y: (root.height - 6px) / 2;
        width: 9px + (root.width - 18px) * Math.max(0, Math.min(1, (root.value - root.minimum) / Math.max(1, root.maximum - root.minimum)));
        height: 6px;
        border-radius: 3px;
        background: root.enabled ? Palette.accent : Palette.disabled;
    }
    // The live level, drawn inside the same track and over the setting fill.
    // Its width never leaves the track and it does not move the knob, so one
    // slider shows both the volume setting and the signal. A thin inset keeps
    // the teal fill visible as a rim above and below.
    Rectangle {
        x: 1px;
        y: (root.height - 4px) / 2;
        width: (root.width - 2px) * Math.max(0, Math.min(1, root.level));
        height: 4px;
        border-radius: 2px;
        background: root.level > 0.85 ? Palette.meter-high : (root.level > 0.6 ? Palette.meter-mid : Palette.meter-low);
    }
    Rectangle {
        x: (root.width - 18px) * Math.max(0, Math.min(1, (root.value - root.minimum) / Math.max(1, root.maximum - root.minimum)));
        y: (root.height - 18px) / 2;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Palette.card;
        border-width: 2px;
        border-color: root.enabled ? Palette.accent : Palette.disabled;
    }

    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.dragging = true;
                root.changed(root.value-at(ta.mouse-x));
            } else if (event.kind == PointerEventKind.move && root.dragging) {
                root.changed(root.value-at(ta.mouse-x));
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                if (root.dragging) {
                    root.released();
                }
                root.dragging = false;
            }
        }
    }
}

component Card inherits Rectangle {
    in property <length> pad: 14px;
    border-radius: 14px;
    background: Palette.card;
    border-width: 1px;
    border-color: Palette.line;

    VerticalLayout {
        padding: root.pad;
        spacing: 8px;
        @children
    }
}

component MiniLink inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;
    height: 26px;
    border-radius: 7px;
    background: ta.has-hover ? Palette.hover : transparent;
    Text {
        width: 100%;
        text: root.label;
        color: root.enabled ? Palette.accent : Palette.disabled;
        font-size: 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    title: "Capture Button";
    // No `icon:` on purpose. Slint turns the image into one 256 px HICON with a
    // single 1-bit mask, and every smaller copy Windows draws from it (the Task
    // Manager process row, the title bar at 100 %) comes out stippled and
    // pixelated. The window icons come from the executable's multi-size .ico
    // instead: platform-windows/src/shell.rs installs them in install_paint_guard.
    min-width: 560px;
    min-height: 520px;
    max-width: 3200px;
    max-height: 2000px;
    background: Palette.bg;
    default-font-family: "Segoe UI";
    default-font-size: 13px * ui-scale;

    in property <float> ui-scale: 1;
    in-out property <int> page: 0;
    in-out property <int> format: 0;
    in-out property <int> preset: 0;
    in-out property <int> resolution: 2;
    in-out property <int> fps: 60;
    in-out property <int> area-format: 1;
    in-out property <int> area-preset: 0;
    in-out property <int> area-resolution: 4;
    in-out property <int> area-fps: 30;
    in-out property <int> video-preset: 0;
    in-out property <int> video-resolution: 2;
    in-out property <int> video-fps: 60;
    in-out property <int> threads: 0;
    in-out property <int> region-renderer: 0;
    in-out property <int> language: 0;
    in-out property <bool> system-audio: true;
    in-out property <bool> microphone: false;
    in-out property <bool> cursor: true;
    in-out property <bool> area-system: true;
    in-out property <bool> area-mic: false;
    in-out property <bool> area-cursor: true;
    in-out property <bool> video-system: true;
    in-out property <bool> video-mic: false;
    in-out property <bool> video-cursor: true;
    in-out property <bool> audio-system: true;
    in-out property <bool> audio-mic: false;
    in-out property <int> gain: 100;
    in-out property <int> area-gain: 100;
    in-out property <int> video-gain: 100;
    in-out property <int> audio-gain: 100;
    in-out property <int> system-gain: 100;
    in-out property <int> area-system-gain: 100;
    in-out property <int> video-system-gain: 100;
    in-out property <int> audio-system-gain: 100;
    // Live levels for the sliders, 0..1, pushed by the recording timer:
    // microphone and system per profile, in Capture, Area, Video, Audio order.
    in-out property <float> mic-level: 0;
    in-out property <float> system-level: 0;
    in-out property <float> area-mic-level: 0;
    in-out property <float> area-system-level: 0;
    in-out property <float> video-mic-level: 0;
    in-out property <float> video-system-level: 0;
    in-out property <float> audio-mic-level: 0;
    in-out property <float> audio-system-level: 0;
    in-out property <bool> autostart: false;
    in-out property <bool> start-minimized: false;
    in-out property <bool> hide-active: false;
    in-out property <bool> close-tray: false;
    in-out property <bool> clipboard: false;
    in-out property <bool> tray-capture: false;
    in-out property <bool> highlight: true;
    in property <bool> outline-supported: true;
    in-out property <bool> sound: true;
    in-out property <int> sound-volume: 50;
    in-out property <bool> show-idle-level: true;
    in-out property <bool> shot-sound: true;
    in-out property <bool> no-signal: true;
    in-out property <bool> show-card: true;
    in-out property <int> capture-device: 0;
    in-out property <int> area-device: 0;
    in-out property <int> video-device: 0;
    in-out property <int> audio-device: 0;
    in-out property <int> system-device: 0;
    in-out property <int> area-system-device: 0;
    in-out property <int> video-system-device: 0;
    in-out property <int> audio-system-device: 0;
    in-out property <[string]> capture-devices: [Labels.auto];
    in-out property <[string]> area-devices: [Labels.auto];
    in-out property <[string]> video-devices: [Labels.auto];
    in-out property <[string]> audio-devices: [Labels.auto];
    in-out property <[string]> system-devices: [Labels.auto];
    in property <[string]> monitor-names: [Labels.auto];
    in property <bool> monitors-supported: false;
    in-out property <int> video-monitor: 0;
    /// The hotkey rows, one per platform action, in table order.
    in property <[HotkeyRow]> hotkey-rows: [];
    /// Which row is capturing a key press; -1 when none is.
    in-out property <int> hotkey-capture: -1;
    /// The desktop owns the combinations and asks in its own dialog.
    in property <bool> hotkeys-dialog: false;
    /// The system dialog is open right now.
    in property <bool> hotkeys-pending: false;
    in property <bool> hotkeys-supported: false;
    in-out property <[string]> language-names: ["System"];
    in property <[string]> region-renderer-names: ["GDI"];
    in-out property <[string]> history: [];
    in-out property <string> status: "";
    in-out property <bool> status-saved: false;
    in-out property <string> stop-label: "Stop capture";
    in-out property <bool> idle: true;
    in-out property <bool> recording: false;
    in-out property <bool> saving: false;
    in-out property <length> capture-scroll: 0px;
    in-out property <length> settings-scroll: 0px;
    in-out property <bool> about-open: false;
    in-out property <string> update-label: "";
    in-out property <bool> update-enabled: false;
    in-out property <bool> update-primary: false;
    in-out property <bool> source-open: false;
    in-out property <bool> camera-open: false;
    in-out property <[string]> camera-items: [];
    in-out property <int> source-monitors: 0;
    in-out property <int> history-ack: -1;
    private property <length> triple: (root.width - 72px * ui-scale) / 3;
    private property <length> about-quad: (540px * ui-scale - 54px * ui-scale) / 4;
    private property <length> half: (root.width - 90px * ui-scale) / 2;
    in-out property <[string]> source-monitor-items: [];
    in-out property <[string]> source-window-items: [];
    in-out property <string> folder-default: "";
    in-out property <string> folder-screenshots: "";
    in-out property <string> folder-video: "";
    in-out property <string> folder-camera: "";
    in-out property <string> folder-audio: "";
    in-out property <bool> default-folder-custom: false;
    in-out property <bool> screenshot-folder-custom: false;
    in-out property <bool> video-folder-custom: false;
    in-out property <bool> camera-folder-custom: false;
    in-out property <bool> audio-folder-custom: false;

    callback act(int);
    callback toggle(int);
    callback choose(int, string);
    callback slide(int, int, bool);
    callback history-click(int);
    callback hotkey-key(int, string, bool, bool, bool, bool);
    callback hotkey-clear(int);
    callback hotkey-change(int);
    callback window-closed();

    property <bool> can-tab: root.idle || root.recording;
    property <bool> can-capture: root.idle;
    property <bool> can-stop: root.recording;

    // The keyboard scope is behind the interface, so it never takes a click
    // meant for a control. It takes the keyboard when the hotkey field is
    // clicked and turns the next combination into the stored text.
    keys := FocusScope {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            if (root.hotkey-capture < 0) {
                return EventResult.reject;
            }
            if (event.text == "\u{001b}") {
                root.hotkey-capture = -1;
                return EventResult.accept;
            }
            root.hotkey-key(root.hotkey-capture, event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
            return EventResult.accept;
        }
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        Rectangle {
            height: 52px * ui-scale;
            background: @linear-gradient(180deg, Palette.deep-2 0%, Palette.deep 100%);

            Rectangle {
                width: 190px * ui-scale;
                height: 32px * ui-scale;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                Image {
                    x: 0px;
                    y: 1px * ui-scale;
                    width: 30px * ui-scale;
                    height: 30px * ui-scale;
                    source: @image-url("../../../assets/CaptureButton-64.png");
                    image-fit: contain;
                }
                Text {
                    x: 38px * ui-scale;
                    y: 0px;
                    width: 150px * ui-scale;
                    height: 32px * ui-scale;
                    text: "Capture Button";
                    color: Palette.on-accent;
                    font-size: 19px * ui-scale;
                    font-weight: 700;
                    letter-spacing: 0.3px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 2px * ui-scale;
            background: @linear-gradient(90deg, Palette.cyan 0%, Palette.accent 40%, Palette.deep 100%);
        }

        Rectangle {
            height: 48px * ui-scale;
            background: Palette.bg;

            HorizontalLayout {
                width: 100%;
                padding-left: 16px * ui-scale;
                padding-right: 16px * ui-scale;
                padding-top: 7px * ui-scale;
                padding-bottom: 7px * ui-scale;
                spacing: 6px * ui-scale;

                Rectangle {
                    width: 96px * ui-scale;
                    height: 30px * ui-scale;
                    border-radius: 15px * ui-scale;
                    background: root.page == 0 ? Palette.card : transparent;
                    border-width: 1px;
                    border-color: root.page == 0 ? Palette.line : transparent;
                    Text { text: Labels.capture; color: root.page == 0 ? Palette.ink : Palette.muted; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.capture-scroll = 0px; root.page = 0; root.act(100); } }
                }
                Rectangle {
                    width: 96px * ui-scale;
                    height: 30px * ui-scale;
                    border-radius: 15px * ui-scale;
                    background: root.page == 1 ? Palette.card : transparent;
                    border-width: 1px;
                    border-color: root.page == 1 ? Palette.line : transparent;
                    Text { text: Labels.settings; color: root.page == 1 ? Palette.ink : Palette.muted; font-size: 12px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.settings-scroll = 0px; root.page = 1; root.act(101); } }
                }

                Rectangle { horizontal-stretch: 1; }

                OceanButton {
                    width: 156px * ui-scale;
                    height: 28px * ui-scale;
                    label: Labels.refresh;
                    enabled: root.idle;
                    clicked => { root.act(102); }
                }
                OceanButton {
                    width: 92px * ui-scale;
                    height: 28px * ui-scale;
                    label: Labels.about;
                    clicked => { root.act(103); }
                }
            }
        }

        Rectangle {
            height: 1px * ui-scale;
            background: Palette.line;
        }

        Rectangle {
            vertical-stretch: 1;
            background: Palette.bg;

            if root.page == 0 : ScrollView {
                vertical-scrollbar-policy: as-needed;
                content-width: self.width;
                content-height: capture-content.preferred-height;
                content-y <=> root.capture-scroll;

                capture-content := VerticalLayout {
                    padding: 16px * ui-scale;
                    spacing: 10px * ui-scale;

                    Card {
                        SectionTitle { text: Labels.format; }
                        HorizontalLayout {
                            spacing: 6px * ui-scale;
                            Chip { width: root.triple; label: "MKV"; active: root.format == 0; clicked => { root.format = 0; root.act(110); } }
                            Chip { width: root.triple; label: "GIF"; active: root.format == 1; clicked => { root.format = 1; root.act(111); } }
                            Chip { width: root.triple; label: "WebP"; active: root.format == 2; clicked => { root.format = 2; root.act(112); } }
                        }
                    }

                    Card {
                        SectionTitle { text: Labels.picture; }
                        HorizontalLayout {
                            spacing: 10px * ui-scale;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px * ui-scale;
                                Text { text: Labels.preset; color: Palette.muted; font-size: 10px * ui-scale; font-weight: 600; }
                                ComboBox {
                                    model: [Labels.quality, Labels.balance, Labels.speed, Labels.custom];
                                    current-index: root.preset;
                                    selected(value) => { root.choose(120, value); }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px * ui-scale;
                                Text { text: Labels.resolution; color: Palette.muted; font-size: 10px * ui-scale; font-weight: 600; }
                                ComboBox {
                                    model: ["2160p", "1440p", "1080p", "720p", "480p", "360p"];
                                    current-index: root.resolution;
                                    selected(value) => { root.choose(121, value); }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px * ui-scale;
                            Text { text: Labels.frame_rate; color: Palette.muted; font-size: 11px * ui-scale; vertical-alignment: center; width: 100px * ui-scale; }
                            OceanSlider {
                                horizontal-stretch: 1;
                                minimum: 5;
                                maximum: 60;
                                value: root.fps;
                                changed(v) => { root.fps = v; root.slide(122, v, false); }
                                released => { root.slide(122, root.fps, true); }
                            }
                            Text { text: root.fps + " FPS"; color: Palette.ink; font-size: 11px * ui-scale; font-weight: 600; width: 52px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.show_cursor; checked: root.cursor; toggled => { root.toggle(186); } }
                    }

                    Card {
                        SectionTitle { text: Labels.audio; }
                        Toggle { label: Labels.system_audio; checked: root.system-audio; toggled => { root.toggle(124); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.system-devices;
                                current-index: root.system-device;
                                selected(value) => { root.choose(229, value); }
                            }
                            OceanSlider {
                                width: 150px * ui-scale;
                                minimum: 0;
                                maximum: 300;
                                value: root.system-gain;
                                level: root.system-level;
                                changed(v) => { root.system-gain = v; root.slide(235, v, false); }
                                released => { root.slide(235, root.system-gain, true); }
                            }
                            Text { text: root.system-gain + "%"; color: Palette.ink; font-size: 11px * ui-scale; font-weight: 600; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.microphone; checked: root.microphone; toggled => { root.toggle(125); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.capture-devices;
                                current-index: root.capture-device;
                                selected(value) => { root.choose(126, value); }
                            }
                            OceanSlider {
                                width: 150px * ui-scale;
                                minimum: 0;
                                maximum: 300;
                                value: root.gain;
                                level: root.mic-level;
                                changed(v) => { root.gain = v; root.slide(194, v, false); }
                                released => { root.slide(194, root.gain, true); }
                            }
                            Text { text: root.gain + "%"; color: Palette.ink; font-size: 11px * ui-scale; font-weight: 600; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                    }

                    Card {
                        SectionTitle { text: Labels.screenshots; }
                        HorizontalLayout {
                            spacing: 6px * ui-scale;
                            OceanButton { width: root.triple; label: Labels.screenshot_screen; enabled: root.idle || root.recording; clicked => { root.act(130); } }
                            OceanButton { width: root.triple; label: Labels.screenshot_source; enabled: root.idle || root.recording; clicked => { root.act(147); } }
                            OceanButton { width: root.triple; label: Labels.screenshot_area; enabled: root.idle || root.recording; clicked => { root.act(131); } }
                        }

                        SectionTitle { text: Labels.video_recording; }
                        HorizontalLayout {
                            spacing: 6px * ui-scale;
                            OceanButton { width: root.triple; primary: true; label: Labels.record_screen; enabled: root.can-capture; clicked => { root.act(132); } }
                            OceanButton { width: root.triple; label: Labels.choose_source; enabled: root.can-capture; clicked => { root.act(148); } }
                            OceanButton { width: root.triple; label: Labels.area_capture; enabled: root.can-capture; clicked => { root.act(133); } }
                        }

                        SectionTitle { text: Labels.camera; }
                        HorizontalLayout {
                            spacing: 6px * ui-scale;
                            OceanButton { horizontal-stretch: 1; label: Labels.camera_photo; enabled: root.can-capture; clicked => { root.act(289); } }
                            OceanButton { horizontal-stretch: 1; label: Labels.camera_video; enabled: root.can-capture; clicked => { root.act(290); } }
                        }

                        SectionTitle { text: Labels.audio_capture; }
                        OceanButton {
                            horizontal-stretch: 1;
                            label: Labels.capture_audio;
                            enabled: root.can-capture;
                            clicked => { root.act(134); }
                        }

                        Rectangle { height: 1px; background: Palette.line; }
                        OceanButton {
                            horizontal-stretch: 1;
                            primary: root.recording;
                            label: root.stop-label;
                            enabled: root.can-stop;
                            clicked => { root.act(135); }
                        }
                    }

                    Card {
                        SectionTitle { text: Labels.recent; }
                        if root.history.length == 0 : Text {
                            text: Labels.no_captures;
                            color: Palette.muted;
                            font-size: 11px * ui-scale;
                            height: 28px * ui-scale;
                            vertical-alignment: center;
                        }
                        for line[index] in root.history : Rectangle {
                            height: 32px * ui-scale;
                            border-radius: 7px * ui-scale;
                            HorizontalLayout {
                                padding-left: 8px * ui-scale;
                                padding-right: 4px * ui-scale;
                                spacing: 4px * ui-scale;
                                Rectangle {
                                    width: 12px * ui-scale;
                                    height: 100%;
                                    Rectangle {
                                        width: 5px * ui-scale;
                                        height: 5px * ui-scale;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 2.5px * ui-scale;
                                        background: Palette.accent;
                                    }
                                }
                                Text {
                                    text: line;
                                    color: Palette.ink;
                                    font-size: 11px * ui-scale;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                MiniLink { width: 88px * ui-scale; label: root.history-ack == 230 + index ? Labels.copied : Labels.copy; clicked => { root.history-click(230 + index); } }
                                MiniLink { width: 72px * ui-scale; label: Labels.folder; clicked => { root.history-click(250 + index); } }
                                MiniLink { width: 72px * ui-scale; label: Labels.open; clicked => { root.history-click(270 + index); } }
                            }
                        }
                    }
                }
            }

            if root.page == 1 : ScrollView {
                vertical-scrollbar-policy: as-needed;
                content-width: self.width;
                content-height: settings-content.preferred-height;
                content-y <=> root.settings-scroll;

                settings-content := VerticalLayout {
                    padding: 16px * ui-scale;
                    spacing: 10px * ui-scale;

                    Card {
                        SectionTitle { text: Labels.language; }
                        ComboBox {
                            model: root.language-names;
                            current-index: root.language;
                            selected(value) => { root.choose(223, value); }
                        }
                    }

                    Card {
                        SectionTitle { text: Labels.performance_overlay; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px * ui-scale;
                            Text { text: Labels.encoder_threads; color: Palette.muted; font-size: 10px * ui-scale; font-weight: 600; }
                            ComboBox {
                                model: [Labels.auto, "1", "2", "4"];
                                current-index: root.threads;
                                selected(value) => { root.choose(180, value); }
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px * ui-scale;
                            Text { text: Labels.overlay_renderer; color: Palette.muted; font-size: 10px * ui-scale; font-weight: 600; }
                            ComboBox {
                                model: root.region-renderer-names;
                                current-index: root.region-renderer;
                                selected(value) => { root.choose(228, value); }
                            }
                        }
                    }

                    Card {
                        SectionTitle { text: Labels.file_locations; }

                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px * ui-scale;
                                Text { text: Labels.default_folder; color: Palette.ink; font-size: 12px * ui-scale; font-weight: 600; }
                                Text { text: root.folder-default; color: Palette.muted; font-size: 10px * ui-scale; overflow: elide; }
                            }
                            OceanButton { width: 96px * ui-scale; height: 28px * ui-scale; label: Labels.change; clicked => { root.act(300); } }
                            OceanButton { width: 80px * ui-scale; height: 28px * ui-scale; label: Labels.reset; enabled: root.default-folder-custom; clicked => { root.act(310); } }
                        }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px * ui-scale;
                                Text { text: Labels.screenshots; color: Palette.ink; font-size: 12px * ui-scale; font-weight: 600; }
                                Text { text: root.folder-screenshots; color: Palette.muted; font-size: 10px * ui-scale; overflow: elide; }
                            }
                            OceanButton { width: 96px * ui-scale; height: 28px * ui-scale; label: Labels.change; clicked => { root.act(301); } }
                            OceanButton { width: 80px * ui-scale; height: 28px * ui-scale; label: Labels.reset; enabled: root.screenshot-folder-custom; clicked => { root.act(311); } }
                        }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px * ui-scale;
                                Text { text: Labels.video_animations; color: Palette.ink; font-size: 12px * ui-scale; font-weight: 600; }
                                Text { text: root.folder-video; color: Palette.muted; font-size: 10px * ui-scale; overflow: elide; }
                            }
                            OceanButton { width: 96px * ui-scale; height: 28px * ui-scale; label: Labels.change; clicked => { root.act(302); } }
                            OceanButton { width: 80px * ui-scale; height: 28px * ui-scale; label: Labels.reset; enabled: root.video-folder-custom; clicked => { root.act(312); } }
                        }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px * ui-scale;
                                Text { text: Labels.camera; color: Palette.ink; font-size: 12px * ui-scale; font-weight: 600; }
                                Text { text: root.folder-camera; color: Palette.muted; font-size: 10px * ui-scale; overflow: elide; }
                            }
                            OceanButton { width: 96px * ui-scale; height: 28px * ui-scale; label: Labels.change; clicked => { root.act(303); } }
                            OceanButton { width: 80px * ui-scale; height: 28px * ui-scale; label: Labels.reset; enabled: root.camera-folder-custom; clicked => { root.act(313); } }
                        }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px * ui-scale;
                                Text { text: Labels.audio; color: Palette.ink; font-size: 12px * ui-scale; font-weight: 600; }
                                Text { text: root.folder-audio; color: Palette.muted; font-size: 10px * ui-scale; overflow: elide; }
                            }
                            OceanButton { width: 96px * ui-scale; height: 28px * ui-scale; label: Labels.change; clicked => { root.act(304); } }
                            OceanButton { width: 80px * ui-scale; height: 28px * ui-scale; label: Labels.reset; enabled: root.audio-folder-custom; clicked => { root.act(314); } }
                        }
                    }

                    Card {
                        SectionTitle { text: Labels.preferences; }
                        Toggle { label: Labels.start_with_windows; checked: root.autostart; toggled => { root.toggle(150); } }
                        Toggle { label: Labels.start_minimized; enabled: root.autostart; checked: root.start-minimized; toggled => { root.toggle(151); } }
                        Toggle { label: Labels.hide_active; checked: root.hide-active; toggled => { root.toggle(152); } }
                        Toggle { label: Labels.close_tray; checked: root.close-tray; toggled => { root.toggle(153); } }
                        Toggle { label: Labels.clipboard; checked: root.clipboard; toggled => { root.toggle(154); } }
                        Toggle { label: Labels.tray_capture; checked: root.tray-capture; toggled => { root.toggle(155); } }
                        Text {
                            text: Labels.tray_capture_hint;
                            color: Palette.muted;
                            font-size: 10px * ui-scale;
                            wrap: word-wrap;
                            visible: Labels.tray_capture_hint != "";
                        }
                        Toggle { label: Labels.highlight; visible: root.outline-supported; checked: root.highlight; toggled => { root.toggle(156); } }
                        Toggle { label: Labels.no_signal; checked: root.no-signal; toggled => { root.toggle(158); } }
                        Toggle { label: Labels.show_card; enabled: root.no-signal; checked: root.show-card; toggled => { root.toggle(159); } }
                    }

                    Card {
                        visible: root.hotkeys-supported;
                        SectionTitle { text: Labels.hotkeys; }
                            for row in root.hotkey-rows : Rectangle {
                                width: 100%;
                                height: 30px * ui-scale;
                                HorizontalLayout {
                                    width: 100%;
                            spacing: 8px * ui-scale;
                            Text { text: row.label; color: Palette.ink; font-size: 12px * ui-scale; width: 120px * ui-scale; vertical-alignment: center; }
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 30px * ui-scale;
                                border-radius: 8px * ui-scale;
                                background: Palette.bg;
                                border-width: 1px;
                                border-color: (row-capture-ta.has-hover && !root.hotkeys-dialog) ? Palette.accent : Palette.line;
                                clip: true;
                                Text {
                                    x: 10px * ui-scale;
                                    y: 0px;
                                    width: parent.width - 46px * ui-scale;
                                    height: parent.height;
                                    text: (!root.hotkeys-dialog && root.hotkey-capture == row.action) ? Labels.press_keys : (row.value == "" ? Labels.not_set : row.value);
                                    color: ((!root.hotkeys-dialog && root.hotkey-capture == row.action) || row.value == "") ? Palette.muted : Palette.ink;
                                    font-size: 12px * ui-scale;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                row-capture-ta := TouchArea {
                                    enabled: !root.hotkeys-dialog && !root.hotkeys-pending;
                                    clicked => { root.hotkey-capture = row.action; keys.focus(); }
                                }
                                Rectangle {
                                    x: parent.width - 30px * ui-scale;
                                    y: 3px * ui-scale;
                                    width: 24px * ui-scale;
                                    height: 24px * ui-scale;
                                    border-radius: 7px * ui-scale;
                                    background: row-clear-ta.enabled && row-clear-ta.has-hover ? Palette.hover : transparent;
                                    visible: root.hotkeys-dialog || row.value != "";
                                    Path {
                                        x: 6px * ui-scale;
                                        y: 6px * ui-scale;
                                        width: 12px * ui-scale;
                                        height: 12px * ui-scale;
                                        viewbox-width: 12;
                                        viewbox-height: 12;
                                        commands: "M 0 0 L 12 12 M 12 0 L 0 12";
                                        stroke: !row-clear-ta.enabled ? Palette.disabled : (row-clear-ta.has-hover ? Palette.danger : Palette.muted);
                                        stroke-width: 1.6px * ui-scale;
                                        stroke-line-cap: round;
                                        fill: transparent;
                                    }
                                    row-clear-ta := TouchArea {
                                        enabled: row.value != "" && !root.hotkeys-pending;
                                        mouse-cursor: pointer;
                                        clicked => { root.hotkey-clear(row.action); }
                                    }
                                }
                            }
                            if root.hotkeys-dialog : Rectangle {
                                // The desktop owns the combination: this asks it
                                // for a new one instead of capturing a press.
                                width: 66px * ui-scale;
                                height: 30px * ui-scale;
                                border-radius: 8px * ui-scale;
                                background: row-change-ta.has-hover ? Palette.hover : Palette.card;
                                border-width: 1px;
                                border-color: Palette.line;
                                Text {
                                    text: row.value == "" ? Labels.set_hotkey : Labels.change;
                                    color: root.hotkeys-pending ? Palette.disabled : Palette.ink;
                                    font-size: 11px * ui-scale;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                row-change-ta := TouchArea {
                                    enabled: row.value != "" && !root.hotkeys-pending;
                                    mouse-cursor: pointer;
                                    clicked => { root.hotkey-change(row.action); }
                                }
                            }
                        }
                            }
                        Text {
                            text: Labels.set_in_system_dialog;
                            color: Palette.muted;
                            font-size: 10px * ui-scale;
                            wrap: word-wrap;
                            visible: root.hotkeys-pending;
                        }
                    }

                    Card {
                        SectionTitle { text: Labels.tray_area; }
                        HorizontalLayout {
                            spacing: 6px * ui-scale;
                            Chip { width: root.triple; label: "MKV"; active: root.area-format == 0; clicked => { root.area-format = 0; root.act(160); } }
                            Chip { width: root.triple; label: "GIF"; active: root.area-format == 1; clicked => { root.area-format = 1; root.act(161); } }
                            Chip { width: root.triple; label: "WebP"; active: root.area-format == 2; clicked => { root.area-format = 2; root.act(162); } }
                        }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: [Labels.quality, Labels.balance, Labels.speed, Labels.custom];
                                current-index: root.area-preset;
                                selected(value) => { root.choose(169, value); }
                            }
                            ComboBox {
                                horizontal-stretch: 1;
                                model: ["2160p", "1440p", "1080p", "720p", "480p", "360p"];
                                current-index: root.area-resolution;
                                selected(value) => { root.choose(163, value); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            Text { text: Labels.frame_rate; color: Palette.muted; font-size: 11px; width: 100px * ui-scale; vertical-alignment: center; }
                            OceanSlider { horizontal-stretch: 1; minimum: 5; maximum: 60; value: root.area-fps; changed(v) => { root.area-fps = v; root.slide(164, v, false); } released => { root.slide(164, root.area-fps, true); } }
                            Text { text: root.area-fps + " FPS"; color: Palette.ink; font-size: 11px; width: 52px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.system_audio; checked: root.area-system; toggled => { root.toggle(166); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.system-devices;
                                current-index: root.area-system-device;
                                selected(value) => { root.choose(232, value); }
                            }
                            OceanSlider {
                                width: 150px * ui-scale;
                                minimum: 0;
                                maximum: 300;
                                value: root.area-system-gain;
                                level: root.area-system-level;
                                changed(v) => { root.area-system-gain = v; root.slide(236, v, false); }
                                released => { root.slide(236, root.area-system-gain, true); }
                            }
                            Text { text: root.area-system-gain + "%"; color: Palette.ink; font-size: 11px * ui-scale; font-weight: 600; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.microphone; checked: root.area-mic; toggled => { root.toggle(167); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox { horizontal-stretch: 1; model: root.area-devices; current-index: root.area-device; selected(value) => { root.choose(168, value); } }
                            OceanSlider { width: 150px * ui-scale; minimum: 0; maximum: 300; value: root.area-gain; level: root.area-mic-level; changed(v) => { root.area-gain = v; root.slide(195, v, false); } released => { root.slide(195, root.area-gain, true); } }
                            Text { text: root.area-gain + "%"; color: Palette.ink; font-size: 11px; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.show_cursor; checked: root.area-cursor; toggled => { root.toggle(187); } }
                    }

                    Card {
                        SectionTitle { text: Labels.tray_video; }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: [Labels.quality, Labels.balance, Labels.speed, Labels.custom];
                                current-index: root.video-preset;
                                selected(value) => { root.choose(179, value); }
                            }
                            ComboBox {
                                horizontal-stretch: 1;
                                model: ["2160p", "1440p", "1080p", "720p", "480p", "360p"];
                                current-index: root.video-resolution;
                                selected(value) => { root.choose(173, value); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            Text { text: Labels.frame_rate; color: Palette.muted; font-size: 11px; width: 100px * ui-scale; vertical-alignment: center; }
                            OceanSlider { horizontal-stretch: 1; minimum: 5; maximum: 60; value: root.video-fps; changed(v) => { root.video-fps = v; root.slide(174, v, false); } released => { root.slide(174, root.video-fps, true); } }
                            Text { text: root.video-fps + " FPS"; color: Palette.ink; font-size: 11px; width: 52px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            visible: root.monitors-supported;
                            spacing: 8px * ui-scale;
                            Text { text: Labels.monitor; color: Palette.muted; font-size: 11px; width: 100px * ui-scale; vertical-alignment: center; }
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.monitor-names;
                                current-index: root.video-monitor;
                                selected(value) => { root.choose(242, value); }
                            }
                        }
                        Toggle { label: Labels.system_audio; checked: root.video-system; toggled => { root.toggle(176); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.system-devices;
                                current-index: root.video-system-device;
                                selected(value) => { root.choose(233, value); }
                            }
                            OceanSlider {
                                width: 150px * ui-scale;
                                minimum: 0;
                                maximum: 300;
                                value: root.video-system-gain;
                                level: root.video-system-level;
                                changed(v) => { root.video-system-gain = v; root.slide(237, v, false); }
                                released => { root.slide(237, root.video-system-gain, true); }
                            }
                            Text { text: root.video-system-gain + "%"; color: Palette.ink; font-size: 11px * ui-scale; font-weight: 600; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.microphone; checked: root.video-mic; toggled => { root.toggle(177); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox { horizontal-stretch: 1; model: root.video-devices; current-index: root.video-device; selected(value) => { root.choose(178, value); } }
                            OceanSlider { width: 150px * ui-scale; minimum: 0; maximum: 300; value: root.video-gain; level: root.video-mic-level; changed(v) => { root.video-gain = v; root.slide(196, v, false); } released => { root.slide(196, root.video-gain, true); } }
                            Text { text: root.video-gain + "%"; color: Palette.ink; font-size: 11px; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.show_cursor; checked: root.video-cursor; toggled => { root.toggle(188); } }
                    }

                    Card {
                        SectionTitle { text: Labels.tray_audio; }
                        Toggle { label: Labels.system_audio; checked: root.audio-system; toggled => { root.toggle(190); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox {
                                horizontal-stretch: 1;
                                model: root.system-devices;
                                current-index: root.audio-system-device;
                                selected(value) => { root.choose(234, value); }
                            }
                            OceanSlider {
                                width: 170px * ui-scale;
                                minimum: 0;
                                maximum: 300;
                                value: root.audio-system-gain;
                                level: root.audio-system-level;
                                changed(v) => { root.audio-system-gain = v; root.slide(238, v, false); }
                                released => { root.slide(238, root.audio-system-gain, true); }
                            }
                            Text { text: root.audio-system-gain + "%"; color: Palette.ink; font-size: 11px * ui-scale; font-weight: 600; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.microphone; checked: root.audio-mic; toggled => { root.toggle(191); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            ComboBox { horizontal-stretch: 1; model: root.audio-devices; current-index: root.audio-device; selected(value) => { root.choose(192, value); } }
                            OceanSlider { width: 170px * ui-scale; minimum: 0; maximum: 300; value: root.audio-gain; level: root.audio-mic-level; changed(v) => { root.audio-gain = v; root.slide(197, v, false); } released => { root.slide(197, root.audio-gain, true); } }
                            Text { text: root.audio-gain + "%"; color: Palette.ink; font-size: 11px; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                    }

                    Card {
                        SectionTitle { text: Labels.sounds; }
                        Toggle { label: Labels.play_on_save; checked: root.sound; toggled => { root.toggle(157); } }
                        Toggle { label: Labels.play_on_shot; checked: root.shot-sound; toggled => { root.toggle(227); } }
                        HorizontalLayout {
                            spacing: 8px * ui-scale;
                            Text { text: Labels.volume; color: Palette.muted; font-size: 11px * ui-scale; width: 90px * ui-scale; vertical-alignment: center; }
                            OceanSlider {
                                horizontal-stretch: 1;
                                minimum: 0;
                                maximum: 100;
                                value: root.sound-volume;
                                changed(v) => { root.sound-volume = v; root.slide(226, v, false); }
                                released => { root.slide(226, root.sound-volume, true); }
                            }
                            Text { text: root.sound-volume + "%"; color: Palette.ink; font-size: 11px * ui-scale; font-weight: 600; width: 42px * ui-scale; horizontal-alignment: right; vertical-alignment: center; }
                        }
                        Toggle { label: Labels.show_level_idle; checked: root.show-idle-level; toggled => { root.toggle(246); } }
                    }
                }
            }
        }
    }

    if root.source-open : Rectangle {
        background: #051a2288;

        TouchArea {
            scroll-event(event) => { accept }
            clicked => { root.act(285); }
        }

        Rectangle {
            width: 460px * ui-scale;
            height: 360px * ui-scale;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 16px * ui-scale;
            background: Palette.card;
            border-width: 1px;
            border-color: Palette.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00101555;
            drop-shadow-offset-y: 8px;

            TouchArea {
                scroll-event(event) => { accept }
            }

            VerticalLayout {
                padding: 18px * ui-scale;
                spacing: 6px * ui-scale;

                Text { text: Labels.choose_source; color: Palette.ink; font-size: 18px * ui-scale; font-weight: 700; }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px * ui-scale;
                    background: Palette.bg;
                    border-width: 1px;
                    border-color: Palette.line;
                    ScrollView {
                        vertical-scrollbar-policy: as-needed;
                        content-width: self.width;
                        content-height: sources-content.preferred-height;
                        sources-content := VerticalLayout {
                            padding: 4px * ui-scale;
                            spacing: 2px * ui-scale;
                            for item[index] in root.source-monitor-items : Rectangle {
                                height: 30px * ui-scale;
                                border-radius: 7px * ui-scale;
                                background: source-monitor-ta.has-hover ? Palette.hover : transparent;
                                HorizontalLayout {
                                    padding-left: 8px * ui-scale;
                                    Text { horizontal-stretch: 1; text: item; color: Palette.ink; font-size: 11px * ui-scale; vertical-alignment: center; overflow: elide; }
                                }
                                source-monitor-ta := TouchArea { clicked => { root.act(400 + index); } }
                            }
                            Rectangle {
                                visible: root.source-monitors > 0 && root.source-window-items.length > 0;
                                height: 1px;
                                background: Palette.line;
                            }
                            for item[index] in root.source-window-items : Rectangle {
                                height: 30px * ui-scale;
                                border-radius: 7px * ui-scale;
                                background: source-window-ta.has-hover ? Palette.hover : transparent;
                                HorizontalLayout {
                                    padding-left: 8px * ui-scale;
                                    Text { horizontal-stretch: 1; text: item; color: Palette.ink; font-size: 11px * ui-scale; vertical-alignment: center; overflow: elide; }
                                }
                                source-window-ta := TouchArea { clicked => { root.act(400 + root.source-monitors + index); } }
                            }
                        }
                    }
                }
                OceanButton { label: Labels.close; clicked => { root.act(285); } }
            }
        }
    }

    if root.camera-open : Rectangle {
        background: #051a2288;

        TouchArea {
            scroll-event(event) => { accept }
            clicked => { root.act(291); }
        }

        Rectangle {
            width: 420px * ui-scale;
            height: 320px * ui-scale;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 16px * ui-scale;
            background: Palette.card;
            border-width: 1px;
            border-color: Palette.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00101555;
            drop-shadow-offset-y: 8px;

            TouchArea {
                scroll-event(event) => { accept }
            }

            VerticalLayout {
                padding: 18px * ui-scale;
                spacing: 6px * ui-scale;

                Text { text: Labels.camera_choose; color: Palette.ink; font-size: 18px * ui-scale; font-weight: 700; }
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 10px * ui-scale;
                    background: Palette.bg;
                    border-width: 1px;
                    border-color: Palette.line;
                    ScrollView {
                        vertical-scrollbar-policy: as-needed;
                        content-width: self.width;
                        content-height: cameras-content.preferred-height;
                        cameras-content := VerticalLayout {
                            padding: 4px * ui-scale;
                            spacing: 2px * ui-scale;
                            for item[index] in root.camera-items : Rectangle {
                                height: 32px * ui-scale;
                                border-radius: 7px * ui-scale;
                                background: camera-ta.has-hover ? Palette.hover : transparent;
                                HorizontalLayout {
                                    padding-left: 8px * ui-scale;
                                    Text { horizontal-stretch: 1; text: item; color: Palette.ink; font-size: 11px * ui-scale; vertical-alignment: center; overflow: elide; }
                                }
                                camera-ta := TouchArea { clicked => { root.act(500 + index); } }
                            }
                        }
                    }
                }
                OceanButton { label: Labels.close; clicked => { root.act(291); } }
            }
        }
    }

    if root.about-open : Rectangle {
        background: #051a2288;

        TouchArea {
            scroll-event(event) => { accept }
            clicked => { root.act(281); }
        }

        Rectangle {
            width: 540px * ui-scale;
            height: 300px * ui-scale;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 16px * ui-scale;
            background: Palette.card;
            border-width: 1px;
            border-color: Palette.line;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00101555;
            drop-shadow-offset-y: 8px;

            TouchArea {
                scroll-event(event) => { accept }
            }

            VerticalLayout {
                padding: 18px * ui-scale;
                spacing: 6px * ui-scale;

                HorizontalLayout {
                    spacing: 12px * ui-scale;
                    Image {
                        width: 64px * ui-scale;
                        height: 64px * ui-scale;
                        source: @image-url("../../../assets/CaptureButton-64.png");
                        image-fit: contain;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px * ui-scale;
                        Text { text: "Capture Button"; color: Palette.ink; font-size: 22px * ui-scale; font-weight: 700; }
                        Text { text: Labels.about_version; color: Palette.muted; font-size: 11px * ui-scale; }
                    }
                }
                Text { text: Labels.license_text; color: Palette.muted; font-size: 10px * ui-scale; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 6px * ui-scale;
                    OceanButton { width: root.about-quad; label: Labels.site; clicked => { root.act(282); } }
                    OceanButton { width: root.about-quad; label: Labels.open_logs; clicked => { root.act(283); } }
                    OceanButton { width: root.about-quad; label: Labels.github; clicked => { root.act(284); } }
                    OceanButton {
                        width: root.about-quad;
                        label: root.update-label;
                        success: root.update-primary;
                        enabled: root.update-enabled;
                        clicked => { root.act(287); }
                    }
                }
            }
        }
    }
}