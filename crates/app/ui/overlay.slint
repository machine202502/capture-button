// The Slint area-selection overlay.
//
// The window draws nothing by itself: `crates/app/src/overlay.rs` builds the
// scene from `platform_core::region::Model` and pushes it into the properties
// below. Keeping every coordinate in the model (and every rule in the model)
// means this file is a renderer only, and the native GDI overlay keeps the
// behaviour it always had.
//
// Phosphor is embedded so the tool and action buttons use the same glyphs as
// the native overlay; it is not installed on the machine.

import "../../../assets/Phosphor.ttf";

/// A point in the window.
export struct OverlayPoint {
    x: length,
    y: length,
}

/// A rectangle in the window.
export struct OverlayRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

/// One button of the overlay: a rounded pill with a glyph, and a caption when
/// the role has one.
export struct OverlayButton {
    x: length,
    y: length,
    width: length,
    height: length,
    fill: color,
    ink: color,
    edge: color,
    glyph: string,
    caption: string,
    /// 0 none, 1 the ink dot of the colour tool, 2 the stroke of the width
    /// tool, 3 a colour swatch.
    special: int,
    dot: color,
    stroke-width: length,
    swatch-on: bool,
}

/// One annotation. `kind` is 0 for a stroked path, 1 for a filled path, 2 for
/// text and 3 for a dot.
export struct OverlayShape {
    kind: int,
    commands: string,
    color: color,
    stroke-width: length,
    x: length,
    y: length,
    width: length,
    height: length,
    text: string,
    /// The face the model recorded for a text shape.
    font: string,
    font-size: length,
    radius: length,
}

component OverlayShapeView inherits Rectangle {
    in property <OverlayShape> shape;
    width: 100%;
    height: 100%;

    if shape.kind == 3 : Rectangle {
        x: shape.x - shape.radius;
        y: shape.y - shape.radius;
        width: shape.radius * 2;
        height: shape.radius * 2;
        border-radius: shape.radius;
        background: shape.color;
    }

    if shape.kind == 2 : Text {
        x: shape.x;
        y: shape.y;
        width: max(shape.width, 1px);
        text: shape.text;
        color: shape.color;
        font-size: shape.font-size;
        font-family: shape.font;
        wrap: word-wrap;
        horizontal-alignment: left;
        vertical-alignment: top;
    }

    if shape.kind == 0 || shape.kind == 1 : Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: self.width / 1px;
        viewbox-height: self.height / 1px;
        commands: shape.commands;
        stroke: shape.kind == 0 ? shape.color : transparent;
        stroke-width: shape.stroke-width;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: shape.kind == 1 ? shape.color : transparent;
        clip: false;
    }
}

/// One edge band of the open text box, where the native edit control starts a
/// resize. It has to sit above the `TextInput` (which would take the press for
/// the caret) and stay a fixed element while the box is dragged, so the grab
/// survives the window updates.
component EditorEdgeArea inherits TouchArea {
    callback press(x: int, y: int, middle: bool);
    callback drag(x: int, y: int);
    callback release(x: int, y: int);

    mouse-cursor: crosshair;
    pointer-event(event) => {
        if (event.kind == PointerEventKind.down) {
            root.press(round((self.mouse-x + self.x) / 1px), round((self.mouse-y + self.y) / 1px), event.button == PointerEventButton.middle);
        } else if (event.kind == PointerEventKind.up) {
            root.release(round((self.mouse-x + self.x) / 1px), round((self.mouse-y + self.y) / 1px));
        } else if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.cancel) {
            root.drag(round((self.mouse-x + self.x) / 1px), round((self.mouse-y + self.y) / 1px));
        }
    }
}

export component OverlayWindow inherits Window {
    /// The frozen screen, one pixel per window pixel.
    in property <image> frame-image;
    /// The dark cover outside the selection.
    in property <[OverlayRect]> dims;
    /// The selection border.
    in property <[OverlayRect]> borders;
    /// The eight resize handles of the selection.
    in property <[OverlayPoint]> handles;
    in property <length> handle-size: 10px;
    in property <[OverlayButton]> buttons;
    in property <[OverlayShape]> shapes;

    in property <bool> has-badge: false;
    in property <OverlayRect> badge;
    in property <string> badge-text: "";

    in property <string> hint-text: "";

    /// The text box: the edit box the model keeps, which is also where the
    /// native overlay paints its frame and handles.
    in property <bool> has-editor: false;
    in property <OverlayRect> editor;
    /// The wider frame around the padded area the pointer grabs.
    in property <OverlayRect> editor-outer;
    /// The eight resize handles on the edit box (round dots).
    in property <[OverlayPoint]> editor-handles;
    /// The eight resize handles on the padded frame (square grabs).
    in property <[OverlayPoint]> editor-outer-handles;
    in property <length> editor-font-size: 18px;
    in property <color> editor-ink: #ffffff;
    in-out property <string> editor-text: "";
    /// The middle-button area above the text field is armed until a left press
    /// uses it, then disarmed for that press so the press and the caret reach
    /// the field below. A later hover or the end of a drag arms it again.
    in-out property <bool> middle-armed: true;
    /// Set while this component is moving the box with the middle button.
    property <bool> middle-dragging: false;

    in property <length> glyph-size: 17px;
    in property <length> label-size: 15px;
    /// One model pixel in logical units: the chrome constants below are the
    /// native overlay's screen pixels, and Slint lengths are logical.
    in property <float> unit: 1;

    in property <color> accent: #0e7490;
    in property <color> white: #ffffff;
    in property <color> badge-fill: #0f3039;
    in property <color> badge-ink: #ffffff;
    in property <color> hint-ink: #ffffff;
    in property <color> hint-shadow: #07191e;
    /// Slint writes a translucent color as `#RRGGBBAA`, so the alpha is last:
    /// the same 120/255 black the native overlay blends over the screen.
    in property <color> dim: #00000078;

    callback pointer-down(x: int, y: int, middle: bool);
    callback pointer-move(x: int, y: int);
    callback pointer-up(x: int, y: int);
    callback key-event(text: string, control: bool, shift: bool);
    callback commit-text(text: string);
    callback cancel-text();
    callback focus-keys();

    /// The text field takes the keyboard when it opens; give the overlay its
    /// keys back after it closes, the way the native overlay refocuses its window.
    focus-keys => {
        keys.focus();
    }

    /// The text field takes the keyboard when it opens, including after a drag
    /// that moved the box but not the keyboard focus.
    changed has-editor => {
        if (self.has-editor) {
            text-field.focus();
            self.middle-armed = true;
            self.middle-dragging = false;
        }
    }

    title: "Capture Button area";
    no-frame: true;
    always-on-top: true;
    background: #000000;

    // The keyboard scope comes first, so the pointer TouchArea below it is in
    // front for input: a `FocusScope` takes the next press when it does not
    // hold the keyboard (the text field does while it is open), which used to
    // eat the first click on the frame or a handle.
    keys := FocusScope {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        init => {
            self.focus();
        }
        key-pressed(event) => {
            root.key-event(event.text, event.modifiers.control, event.modifiers.shift);
            return EventResult.accept;
        }
    }

    // Input in front of the keyboard scope; the other elements are shapes and
    // text, which never take the mouse. The native overlay's window class shows
    // the same crosshair everywhere.
    TouchArea {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pointer-down(round(self.mouse-x / 1px), round(self.mouse-y / 1px), event.button == PointerEventButton.middle);
            } else if (event.kind == PointerEventKind.up) {
                root.pointer-up(round(self.mouse-x / 1px), round(self.mouse-y / 1px));
                // The drag that a left press started is over; let the middle
                // area above the text field take the next middle press.
                root.middle-armed = true;
            } else if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.cancel) {
                // Hovering without a button re-arms the middle area after a
                // caret click, which grabbed the release inside the text field.
                if (!self.pressed) {
                    root.middle-armed = true;
                }
                root.pointer-move(round(self.mouse-x / 1px), round(self.mouse-y / 1px));
            }
        }
    }

    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.frame-image;
        image-fit: fill;
    }

    for area in root.dims : Rectangle {
        x: area.x;
        y: area.y;
        width: area.width;
        height: area.height;
        background: root.dim;
    }

    for shape in root.shapes : OverlayShapeView {
        shape: shape;
    }

    for area in root.borders : Rectangle {
        x: area.x;
        y: area.y;
        width: area.width;
        height: area.height;
        border-width: 2px * root.unit;
        border-color: root.accent;
        background: transparent;
    }

    for point in root.handles : Rectangle {
        x: point.x - root.handle-size / 2;
        y: point.y - root.handle-size / 2;
        width: root.handle-size;
        height: root.handle-size;
        background: root.accent;
    }

    if root.has-badge : Rectangle {
        x: root.badge.x;
        y: root.badge.y;
        // The text decides the box so a long "1234 ? 567" never clips; the
        // model's own size is only a floor, because it comes from a text-width
        // estimate.
        width: max(root.badge.width, badge-label.width + 16px * root.unit);
        height: max(root.badge.height, badge-label.height + 8px * root.unit);
        border-radius: 6px * root.unit;
        background: root.badge-fill;
        badge-label := Text {
            x: 8px * root.unit;
            y: 0;
            text: root.badge-text;
            color: root.badge-ink;
            font-size: root.label-size;
            font-family: "Segoe UI";
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }

    if root.hint-text != "" : Text {
        x: 40px * root.unit;
        y: 0;
        width: root.width - 80px * root.unit;
        height: root.height;
        text: root.hint-text;
        color: root.hint-ink;
        font-size: root.label-size;
        font-family: "Segoe UI";
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    for button in root.buttons : Rectangle {
        x: button.x;
        y: button.y;
        width: button.width;
        height: button.height;
        border-radius: button.height / 2;
        background: button.fill;
        border-width: 1px * root.unit;
        border-color: button.edge;

        if button.special == 1 : Rectangle {
            x: (parent.width - 16px * root.unit) / 2;
            y: (parent.height - 16px * root.unit) / 2;
            width: 16px * root.unit;
            height: 16px * root.unit;
            border-radius: 8px * root.unit;
            background: button.dot;
            border-width: 2px * root.unit;
            border-color: root.white;
        }

        if button.special == 2 : Rectangle {
            x: 8px * root.unit;
            y: (parent.height - button.stroke-width) / 2;
            width: max(parent.width - 16px * root.unit, 0px);
            height: button.stroke-width;
            background: button.ink;
        }

        if button.special == 3 && button.swatch-on : Rectangle {
            x: 3px * root.unit;
            y: 2px * root.unit;
            width: parent.width - 6px * root.unit;
            height: parent.height - 4px * root.unit;
            border-radius: 4px * root.unit;
            background: transparent;
            border-width: 2px * root.unit;
            border-color: root.white;
        }

        if button.caption == "" : Text {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            text: button.glyph;
            color: button.ink;
            font-size: root.glyph-size;
            font-family: "Phosphor";
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if button.caption != "" : HorizontalLayout {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            alignment: center;
            spacing: 6px * root.unit;
            Text {
                text: button.glyph;
                color: button.ink;
                font-size: root.glyph-size;
                font-family: "Phosphor";
                vertical-alignment: center;
            }
            Text {
                text: button.caption;
                color: button.ink;
                font-size: root.label-size;
                font-family: "Segoe UI";
                vertical-alignment: center;
            }
        }
    }

    // The native overlay draws two frames while the text box is open: a wide
    // one around the padded area the pointer grabs (with square handles on the
    // hit-test spots), and the one on the edit box itself (with round dots).
    if root.has-editor : Rectangle {
        x: root.editor-outer.x;
        y: root.editor-outer.y;
        width: root.editor-outer.width;
        height: root.editor-outer.height;
        border-radius: 6px * root.unit;
        border-width: 2px * root.unit;
        border-color: root.accent;
        background: transparent;
    }

    for point in root.editor-outer-handles : Rectangle {
        x: point.x - 4px * root.unit;
        y: point.y - 4px * root.unit;
        width: 8px * root.unit;
        height: 8px * root.unit;
        background: root.white;
        border-width: 1px * root.unit;
        border-color: root.accent;
    }

    if root.has-editor : Rectangle {
        x: root.editor.x;
        y: root.editor.y;
        width: root.editor.width;
        height: root.editor.height;
        border-radius: 5px * root.unit;
        border-width: 3px * root.unit;
        border-color: root.accent;
        background: transparent;
    }

    // Kept in the tree and hidden instead of conditional so the overlay can
    // give the keyboard back to it after a drag (the native overlay keeps its
    // edit control focused while the box moves).
    text-field := TextInput {
        visible: root.has-editor;
        x: root.editor.x;
        y: root.editor.y;
        width: root.editor.width;
        height: root.editor.height;
        text <=> root.editor-text;
        color: root.editor-ink;
        font-size: root.editor-font-size;
        font-family: "Segoe UI";
        // The native overlay's editor is multi-line: Shift+Enter inserts a line
        // break, Enter alone commits.
        single-line: false;
        wrap: word-wrap;
        horizontal-alignment: left;
        vertical-alignment: top;
        key-pressed(event) => {
            if (event.text == "\u{001b}") {
                root.cancel-text();
                return EventResult.accept;
            }
            if (event.text == "\u{000a}" && !event.modifiers.shift) {
                root.commit-text(self.text);
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    // The native edit control resizes the box when the press lands in the band
    // inside its own edges, and only moves the caret in the middle. Slint hands
    // every press inside the field to the `TextInput`, so the four bands are
    // covered with touch areas above it; the rest of the field still places the
    // caret. The areas stay in the tree while the box is dragged: rebuilding a
    // model here would drop the grab on the first move.
    if root.has-editor : EditorEdgeArea {
        x: root.editor.x;
        y: root.editor.y;
        width: root.editor.width;
        height: 8px * root.unit;
        press(x, y, middle) => { root.pointer-down(x, y, middle); }
        drag(x, y) => { if (!self.pressed) { root.middle-armed = true; } root.pointer-move(x, y); }
        release(x, y) => { root.pointer-up(x, y); root.middle-armed = true; }
    }
    if root.has-editor : EditorEdgeArea {
        x: root.editor.x;
        y: root.editor.y + root.editor.height - 8px * root.unit;
        width: root.editor.width;
        height: 8px * root.unit;
        press(x, y, middle) => { root.pointer-down(x, y, middle); }
        drag(x, y) => { if (!self.pressed) { root.middle-armed = true; } root.pointer-move(x, y); }
        release(x, y) => { root.pointer-up(x, y); root.middle-armed = true; }
    }
    if root.has-editor : EditorEdgeArea {
        x: root.editor.x;
        y: root.editor.y + 8px * root.unit;
        width: 8px * root.unit;
        height: max(root.editor.height - 16px * root.unit, 0px);
        press(x, y, middle) => { root.pointer-down(x, y, middle); }
        drag(x, y) => { if (!self.pressed) { root.middle-armed = true; } root.pointer-move(x, y); }
        release(x, y) => { root.pointer-up(x, y); root.middle-armed = true; }
    }
    if root.has-editor : EditorEdgeArea {
        x: root.editor.x + root.editor.width - 8px * root.unit;
        y: root.editor.y + 8px * root.unit;
        width: 8px * root.unit;
        height: max(root.editor.height - 16px * root.unit, 0px);
        press(x, y, middle) => { root.pointer-down(x, y, middle); }
        drag(x, y) => { if (!self.pressed) { root.middle-armed = true; } root.pointer-move(x, y); }
        release(x, y) => { root.pointer-up(x, y); root.middle-armed = true; }
    }

    // Slint gives every press inside the text field to the `TextInput`, and the
    // field accepts a middle press without exposing it. This area above the
    // field starts the box move for the middle button; for a left or right
    // press it disables itself in the callback, and Slint then delivers the
    // same press to the field (caret) or to the edge band below (resize).
    middle-drag := TouchArea {
        x: root.editor-outer.x;
        y: root.editor-outer.y;
        width: root.editor-outer.width;
        height: root.editor-outer.height;
        enabled: root.has-editor && root.middle-armed;
        mouse-cursor: crosshair;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.middle) {
                    root.middle-dragging = true;
                    root.pointer-down(round((self.mouse-x + self.x) / 1px), round((self.mouse-y + self.y) / 1px), true);
                } else {
                    root.middle-armed = false;
                }
            } else if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.cancel) {
                if (root.middle-dragging) {
                    root.pointer-move(round((self.mouse-x + self.x) / 1px), round((self.mouse-y + self.y) / 1px));
                }
            } else if (event.kind == PointerEventKind.up) {
                if (root.middle-dragging) {
                    root.middle-dragging = false;
                    root.pointer-up(round((self.mouse-x + self.x) / 1px), round((self.mouse-y + self.y) / 1px));
                }
            }
        }
    }

    // The same white dots the native overlay paints on the text box.
    for point in root.editor-handles : Rectangle {
        x: point.x - 5px * root.unit;
        y: point.y - 5px * root.unit;
        width: 10px * root.unit;
        height: 10px * root.unit;
        border-radius: 5px * root.unit;
        background: root.white;
        border-width: 1px * root.unit;
        border-color: root.accent;
    }
}
